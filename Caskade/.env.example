# ── Серверы ───────────────────────────────────────────────────
REMNA_HOST=remna
NODE_E_HOST=node_e
NODE_D_HOST=node_d
NODE_F_HOST=aesa

NODE_E_IP=153.80.247.239
NODE_D_IP=78.17.134.17
NODE_F_IP=193.233.137.187

# ── Порты ─────────────────────────────────────────────────────
TRANSIT_PORT=2223
ENTRY_PORT=443
ENTRY_DOMAIN=alphaceiling23.ru

# ── Transit UUID ──────────────────────────────────────────────
# Используется для внутреннего VLESS-туннеля между entry и exit
TRANSIT_UUID=REPLACE_ME_WITH_UUIDGEN

# ── Reality ключи (node_e) ───────────────────────────────────
REALITY_PRIVATE_KEY=REPLACE_ME
REALITY_PUBLIC_KEY=REPLACE_ME
REALITY_SHORT_ID=REPLACE_ME

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
POSTGRES_DB=postgres

# ── JWT ───────────────────────────────────────────────────────
JWT_AUTH_SECRET=REPLACE_ME_64_CHARS
JWT_API_TOKENS_SECRET=REPLACE_ME_64_CHARS

# ── Prometheus Metrics ────────────────────────────────────────
METRICS_USER=admin
METRICS_PASS=REPLACE_ME
