# =============================================================
# Caskade VPN Panel — Environment Template
# =============================================================

APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

# DATABASE URL (Postgres container host and credentials)
DATABASE_URL="postgresql://postgres:REPLACE_ME_WITH_POSTGRES_PASSWORD@remnawave-db:5432/postgres"

# REDIS Valkey Socket Path
REDIS_SOCKET=/var/run/valkey/valkey.sock

# JWT Secrets (64 characters)
JWT_AUTH_SECRET=REPLACE_ME_WITH_STRONG_JWT_SECRET
JWT_API_TOKENS_SECRET=REPLACE_ME_WITH_STRONG_JWT_SECRET

IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
PANEL_DOMAIN=panelhide.su
FRONT_END_DOMAIN=*
SUB_PUBLIC_DOMAIN=sub.panelhide.su
IS_DOCS_ENABLED=false

METRICS_USER=admin
METRICS_PASS=REPLACE_ME_WITH_METRICS_PASS

# Webhooks configuration for Admin Bot notifications
WEBHOOK_ENABLED=true
WEBHOOK_URL=https://admin.panelhide.su/api/v1/remnawave
WEBHOOK_SECRET_HEADER=REPLACE_ME_WITH_64_CHAR_SECRET

# PostgreSQL container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_WITH_POSTGRES_PASSWORD
POSTGRES_DB=postgres
